{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ad-director/contracts/shot_plan.schema.json",
  "title": "ShotPlan",
  "type": "object",
  "required": ["schema_version", "fps", "target_frames", "shots"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "fps": {
      "type": "object",
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "target_frames": { "type": "integer", "minimum": 1 },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": [
        "id",
        "source_type",
        "purpose",
        "target_frames",
        "handles_frames",
        "success_predicate",
        "locks"
      ],
      "properties": {
        "id": { "type": "string" },
        "source_type": { "enum": ["gameplay", "ai_generated", "composed"] },
        "purpose": { "type": "string" },
        "target_frames": { "type": "integer", "minimum": 1 },
        "handles_frames": {
          "type": "object",
          "properties": {
            "before": { "type": "integer", "minimum": 0 },
            "after": { "type": "integer", "minimum": 0 }
          }
        },
        "start_state": { "type": "object" },
        "desired_event": { "type": ["string", "null"] },
        "success_predicate": {
          "type": "object",
          "required": ["required_observations", "evidence_required"],
          "properties": {
            "required_observations": { "type": "array", "items": { "type": "string" } },
            "evidence_required": { "type": "boolean" }
          }
        },
        "action_constraints": {
          "type": "object",
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
            "max_seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "caption": { "type": ["string", "null"] },
        "voice_text": { "type": ["string", "null"] },
        "fallback": { "type": ["string", "null"] },
        "locks": {
          "type": "object",
          "required": ["visual", "voice", "caption", "timing"],
          "properties": {
            "visual": { "type": "boolean" },
            "voice": { "type": "boolean" },
            "caption": { "type": "boolean" },
            "timing": { "type": "boolean" }
          }
        }
      }
    }
  }
}
